+static void logMemorySample(const char* state) {
+    constexpr uint32_t internal = MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT;
+    constexpr uint32_t dma = MALLOC_CAP_DMA | MALLOC_CAP_8BIT;
+    constexpr uint32_t psram = MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT;
+    ESP_LOGI("val-s1", "state=%s int=%u,%u,%u dma=%u,%u,%u psram=%u,%u,%u stack=%u tasks=%u alloc_fail=%u last_fail=%u,%u",
+             state,
+             heap_caps_get_free_size(internal), heap_caps_get_minimum_free_size(internal), heap_caps_get_largest_free_block(internal),
+             heap_caps_get_free_size(dma), heap_caps_get_minimum_free_size(dma), heap_caps_get_largest_free_block(dma),
+             heap_caps_get_free_size(psram), heap_caps_get_minimum_free_size(psram), heap_caps_get_largest_free_block(psram),
+             uxTaskGetStackHighWaterMark(nullptr), uxTaskGetNumberOfTasks(),
+             failedAllocations.load(std::memory_order_relaxed),
+             lastFailedBytes.load(std::memory_order_relaxed),
+             lastFailedCaps.load(std::memory_order_relaxed));
+}
+
+static bool readNvsString(const char* nameSpace, const char* key, std::string& value,
+                          size_t maximumBytes) {
+    nvs_handle_t handle;
+    if (nvs_open(nameSpace, NVS_READONLY, &handle) != ESP_OK) return false;
+    size_t bytes = 0;
+    esp_err_t result = nvs_get_str(handle, key, nullptr, &bytes);
+    if (result != ESP_OK || bytes == 0 || bytes > maximumBytes + 1) {
+        nvs_close(handle);
+        return false;
+    }
+    std::string text(bytes, '\0');
+    result = nvs_get_str(handle, key, text.data(), &bytes);
+    nvs_close(handle);
+    if (result != ESP_OK || bytes == 0) return false;
+    text.resize(bytes - 1);
+    value.swap(text);
+    return !value.empty();
+}
+
+static bool writeNvsString(const char* nameSpace, const char* key,
+                           const std::string& value) {
+    nvs_handle_t handle;
+    if (nvs_open(nameSpace, NVS_READWRITE, &handle) != ESP_OK) return false;
+    const esp_err_t setResult = nvs_set_str(handle, key, value.c_str());
+    const esp_err_t commitResult = setResult == ESP_OK ? nvs_commit(handle) : setResult;
+    nvs_close(handle);
+    return setResult == ESP_OK && commitResult == ESP_OK;
+}
+
+static bool readProvisionLine(const char* prefix, std::string& value) {
+    char buffer[160] = {};
+    size_t used = 0;
+    while (used < sizeof(buffer) - 1) {
+        char character = 0;
+        if (usb_serial_jtag_read_bytes(&character, 1, portMAX_DELAY) != 1) continue;
+        if (character == '\r' || character == '\n') {
+            if (used == 0) continue;
+            buffer[used++] = '\n';
+            break;
+        }
+        buffer[used++] = character;
+    }
+    if (used == sizeof(buffer) - 1) return false;
+    const size_t prefixLength = strlen(prefix);
+    const size_t length = strlen(buffer);
+    if (length == 0 || buffer[length - 1] != '\n' ||
+        strncmp(buffer, prefix, prefixLength) != 0) return false;
+    char* end = buffer + length;
+    while (end > buffer && (end[-1] == '\n' || end[-1] == '\r')) *--end = '\0';
+    value.assign(buffer + prefixLength);
+    memset(buffer, 0, sizeof(buffer));
+    return !value.empty() && value.size() <= 96;
+}
+
+static bool loadSpotifyApp(std::string& clientId, std::string& clientSecret) {
+    if (readNvsString("spotify", "client_id", clientId, 96) &&
+        readNvsString("spotify", "client_secret", clientSecret, 96)) return true;
+    ESP_LOGI(TAG, "Waiting for private USB serial Spotify app provisioning");
+    if (!readProvisionLine("SPOTIFY_CLIENT_ID=", clientId) ||
+        !readProvisionLine("SPOTIFY_CLIENT_SECRET=", clientSecret)) {
+        ESP_LOGE(TAG, "Provisioning format invalid; restart to retry");
+        return false;
+    }
+    if (!writeNvsString("spotify", "client_id", clientId) ||
+        !writeNvsString("spotify", "client_secret", clientSecret)) {
+        ESP_LOGE(TAG, "Could not save Spotify app credentials");
+        return false;
+    }
+    ESP_LOGI(TAG, "Spotify app credentials stored privately");
+    return true;
+}
 
