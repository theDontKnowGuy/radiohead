+namespace {
+// Bound each TLS operation, including repeated WANT_READ/WANT_WRITE. A reset
+// is noticed within one select slice rather than waiting for peer traffic.
+template<class Operation>
+int runTlsOperation(int fd, const std::function<bool()>& cancelled,
+                    Operation&& operation) {
+  if (fd < 0 || fd >= FD_SETSIZE)
+    throw std::runtime_error("TLS socket unavailable");
+  using Clock = std::chrono::steady_clock;
+  const auto deadline = Clock::now() + std::chrono::seconds(5);
+  for (;;) {
+    if (cancelled && cancelled()) throw std::runtime_error("TLS operation cancelled");
+    if (Clock::now() >= deadline) throw std::runtime_error("TLS operation timed out");
+    const int result = operation();
+    if (result >= 0) return result;
+    if (result != MBEDTLS_ERR_SSL_WANT_READ && result != MBEDTLS_ERR_SSL_WANT_WRITE)
+      throw std::runtime_error("TLS operation failed");
+    fd_set ready;
+    FD_ZERO(&ready);
+    FD_SET(fd, &ready);
+    timeval slice = {0, 100000};
+    const int selected = select(fd + 1,
+        result == MBEDTLS_ERR_SSL_WANT_READ ? &ready : nullptr,
+        result == MBEDTLS_ERR_SSL_WANT_WRITE ? &ready : nullptr,
+        nullptr, &slice);
+    if (selected < 0 && errno != EINTR)
+      throw std::runtime_error("TLS socket wait failed");
+  }
+}
